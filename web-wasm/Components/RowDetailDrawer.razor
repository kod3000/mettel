@inject BruinApiClient Api
@inject MeService Me
@inject ToastService Toasts
@inject ErrorReporter Reporter
@implements IDisposable

@* Right-side drawer: view + edit + soft-delete. Mirrors
   apps/web/src/components/RowDetailDrawer.tsx. Per-field mutators are
   split into named methods because Razor rejects `\"literal\"` inside
   inline lambdas in attributes (see session handoff notes). *@

<div class="drawer-backdrop" @onclick="OnBackdrop">
    <aside class="drawer" role="dialog" aria-label="Inventory detail" @onclick:stopPropagation="true">
        <header class="drawer-header">
            <div style="flex:1;min-width:0">
                <div class="eyebrow">Inventory</div>
                <div class="title mono truncate">@(_row?.ServiceNumber ?? "…")</div>
            </div>
            <button class="close-x" @onclick="OnClose" disabled="@_pending" aria-label="Close">✕</button>
        </header>

        <div class="drawer-body">
            @if (_recovering)
            {
                <div class="recovery" role="status">
                    <div class="spinner"></div>
                    <div>
                        <div style="font-weight:600">System auto-recovery in progress</div>
                        <div style="font-size:11px">Backend returned an error — retrying (attempt @(_attempt + 1) of @MaxAttempts).</div>
                    </div>
                </div>
            }

            @if (_row is null && _loadingInitial)
            {
                <div style="color:var(--slate-500);font-size:12px">Loading…</div>
            }
            else if (_row is null && _terminalErr is not null)
            {
                <div class="err-box">
                    <strong>@(_terminalErr.StatusCode == 404 ? "Row not found" : _terminalErr.Problem.Title ?? "Failed to load")</strong>
                    @if (_terminalErr.Problem.Detail is not null) { <div>@_terminalErr.Problem.Detail</div> }
                </div>
            }
            else if (_row is not null && _editing)
            {
                <div class="edit-form">
                    <EditField Label="Service #" Name="serviceNumber" Required="true"
                               Value="@_draft["serviceNumber"]" ValueChanged="OnServiceNumberChanged"
                               ReadOnly="@IsReadOnlyServiceNumber" Errors="@FieldErrs("serviceNumber")" />
                    <EditField Label="Product name" Name="productName" Required="true"
                               Value="@_draft["productName"]" ValueChanged="OnProductNameChanged"
                               ReadOnly="@IsReadOnlyProductName" Errors="@FieldErrs("productName")" />
                    <div class="edit-block">
                        <label>
                            Category
                            @if (IsReadOnlyProductCategory) { <span class="ro-hint">(admin only)</span> }
                        </label>
                        <select disabled="@(IsReadOnlyProductCategory || _pending)"
                                value="@_draft["productCategory"]"
                                @onchange="OnProductCategoryChanged">
                            <option value="voice">voice</option>
                            <option value="data">data</option>
                            <option value="wireless">wireless</option>
                            <option value="other">other</option>
                        </select>
                        @foreach (var m in FieldErrs("productCategory")) { <div class="ferr">@m</div> }
                    </div>
                    <EditField Label="City" Name="city"
                               Value="@_draft["city"]" ValueChanged="OnCityChanged"
                               ReadOnly="@IsReadOnlyCity" Errors="@FieldErrs("city")" />
                    <EditField Label="State" Name="state"
                               Value="@_draft["state"]" ValueChanged="OnStateChanged"
                               ReadOnly="@IsReadOnlyState" Errors="@FieldErrs("state")" />
                    <EditField Label="Address" Name="address"
                               Value="@_draft["address"]" ValueChanged="OnAddressChanged"
                               ReadOnly="@IsReadOnlyAddress" Errors="@FieldErrs("address")" />
                    <EditField Label="Assignee" Name="assignee"
                               Value="@_draft["assignee"]" ValueChanged="OnAssigneeChanged"
                               ReadOnly="@IsReadOnlyAssignee" Errors="@FieldErrs("assignee")" />
                    <div class="edit-block">
                        <label>Notes</label>
                        <textarea rows="3"
                                  disabled="@(IsReadOnlyNotes || _pending)"
                                  value="@_draft["notes"]"
                                  @oninput="OnNotesChanged"></textarea>
                        @foreach (var m in FieldErrs("notes")) { <div class="ferr">@m</div> }
                    </div>
                    <div style="font-size:11px;color:var(--slate-500)">
                        Editing row version <span class="mono">@_row.RowVersion</span>. A concurrent update will 409 and reload the drawer.
                    </div>
                    <div style="display:flex;gap:8px;margin-top:4px">
                        <button class="btn primary" disabled="@_pending" @onclick="SaveEditAsync">
                            @(_pending ? "Saving…" : "Save")
                        </button>
                        <button class="btn" disabled="@_pending" @onclick="CancelEdit">Cancel</button>
                    </div>
                </div>
            }
            else if (_row is not null)
            {
                <Field Label="Service #">
                    <div class="mono">@_row.ServiceNumber</div>
                </Field>
                <Field Label="Product">
                    <div>@_row.ProductName</div>
                    <div class="eyebrow" style="margin-top:2px">@_row.ProductCategory</div>
                </Field>
                <Field Label="Status">
                    <span class="badge @_row.Status">@_row.Status</span>
                </Field>
                <Field Label="Assignee">
                    <div class="mono">@(_row.Assignee ?? "—")</div>
                </Field>
                <Field Label="Location">
                    <div>@LocationLine(_row)</div>
                    @if (!string.IsNullOrWhiteSpace(_row.Address))
                    {
                        <div style="font-size:12px;color:var(--slate-500);margin-top:2px">@_row.Address</div>
                    }
                </Field>
                @if (!string.IsNullOrWhiteSpace(_row.Notes))
                {
                    <Field Label="Notes">
                        <div style="white-space:pre-wrap">@_row.Notes</div>
                    </Field>
                }
                <Field Label="Audit">
                    <div style="font-size:12px;color:var(--slate-600)" class="tabular">
                        <div>Created @Fmt(_row.CreatedAt)</div>
                        <div>Updated @Fmt(_row.UpdatedAt)</div>
                        <div>Row version <span class="mono">@_row.RowVersion</span></div>
                    </div>
                </Field>

                @if (Me.CanWrite)
                {
                    <div class="drawer-row-actions">
                        <button class="btn" @onclick="StartEdit">Edit fields</button>
                        @if (Me.CanDelete)
                        {
                            <button class="btn danger" disabled="@_pending" @onclick="OpenDeleteConfirm">
                                Delete row
                            </button>
                        }
                    </div>
                    <div class="drawer-actions">
                        <div class="eyebrow" style="margin-bottom:8px">Change status</div>
                        @{
                            var nexts = NextStatuses(_row.Status);
                        }
                        @if (nexts.Length == 0)
                        {
                            <div style="font-size:12px;color:var(--slate-500);font-style:italic">
                                Terminal state — no further transitions allowed.
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;flex-wrap:wrap;gap:8px">
                                @foreach (var s in nexts)
                                {
                                    <button
                                        class="btn @BtnKind(s)"
                                        disabled="@_pending"
                                        @onclick="() => PatchStatusAsync(s)">
                                        @(_pending && _pendingTarget == s ? "Working…" : $"→ {s}")
                                    </button>
                                }
                            </div>
                        }

                        @if (_terminalErr is not null && _row is not null)
                        {
                            <div class="err-box" style="margin-top:12px">
                                <strong>@MutationTitle(_terminalErr)</strong>
                                <div style="margin-top:2px">@(_terminalErr.Problem.Detail ?? _terminalErr.Problem.Title ?? "Request failed.")</div>
                                @if (_terminalErr.IsSlug("concurrency-conflict"))
                                {
                                    <div style="margin-top:2px;font-size:11px">Row was refreshed — try again.</div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </aside>
</div>

@if (_confirmDelete && _row is not null)
{
    <div class="modal-backdrop" @onclick="CloseDeleteConfirm">
        <div class="modal" role="alertdialog" @onclick:stopPropagation="true">
            <div style="font-weight:600">Delete inventory row?</div>
            <div style="margin-top:4px;font-size:12px;color:var(--slate-600)">
                <span class="mono">@_row.ServiceNumber</span> — @_row.ProductName
            </div>
            <div style="margin-top:6px;font-size:12px;color:var(--slate-500)">
                Soft delete: the row is hidden from lists but kept for audit. You can re-create
                the same service number afterwards.
            </div>
            <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
                <button class="btn" disabled="@_pending" @onclick="CloseDeleteConfirm">Cancel</button>
                <button class="btn danger" disabled="@_pending" @onclick="DeleteAsync">
                    @(_pending ? "Deleting…" : "Delete")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .edit-form { display: flex; flex-direction: column; gap: 10px; }
    .edit-block label { display: block; font-size: 11px; text-transform: uppercase;
        letter-spacing: 0.04em; color: var(--slate-500); margin-bottom: 4px; }
    .edit-block select, .edit-block textarea {
        width: 100%; padding: 4px 8px; font-size: 13px;
        border: 1px solid var(--slate-300); border-radius: 6px; background: white;
    }
    .edit-block select:disabled, .edit-block textarea:disabled {
        background: var(--slate-100); color: var(--slate-500);
    }
    .ro-hint { margin-left: 4px; font-style: italic; color: var(--slate-400); text-transform: none; }
    .ferr { margin-top: 4px; font-size: 11px; color: #be123c; }
    .drawer-row-actions { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--slate-200);
        display: flex; flex-wrap: wrap; gap: 8px; }
    .btn.danger {
        background: white; border-color: #fda4af; color: #be123c;
    }
    .btn.danger:hover:not(:disabled) { background: var(--rose-50); }
    .modal-backdrop {
        position: fixed; inset: 0; z-index: 40; background: rgb(15 23 42 / 0.4);
        display: flex; align-items: center; justify-content: center; padding: 16px;
    }
    .modal {
        background: white; border-radius: 8px; border: 1px solid var(--slate-200);
        box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.2), 0 8px 10px -6px rgb(0 0 0 / 0.15);
        padding: 16px; max-width: 400px; width: 100%; font-size: 13px;
    }
</style>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = default!;
    [Parameter] public EventCallback OnClosed { get; set; }

    private const int MaxAttempts = 4;
    private static readonly TimeSpan[] Backoff = { TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(4) };

    private InventoryRow? _row;
    private bool _loadingInitial;
    private bool _pending;
    private string? _pendingTarget;
    private ApiException? _terminalErr;
    private bool _recovering;
    private int _attempt;
    private CancellationTokenSource? _cts;

    private bool _editing;
    private bool _confirmDelete;
    private Dictionary<string, string> _draft = new(StringComparer.Ordinal);
    private Dictionary<string, string[]> _fieldErrors = new(StringComparer.Ordinal);

    private static readonly string[] Writable = {
        "serviceNumber", "productName", "productCategory",
        "city", "state", "address", "assignee", "notes",
    };

    // Per-field read-only shortcuts (avoid method calls in Razor bool attrs).
    private bool IsReadOnlyServiceNumber   => IsReadOnly("serviceNumber");
    private bool IsReadOnlyProductName     => IsReadOnly("productName");
    private bool IsReadOnlyProductCategory => IsReadOnly("productCategory");
    private bool IsReadOnlyCity            => IsReadOnly("city");
    private bool IsReadOnlyState           => IsReadOnly("state");
    private bool IsReadOnlyAddress         => IsReadOnly("address");
    private bool IsReadOnlyAssignee        => IsReadOnly("assignee");
    private bool IsReadOnlyNotes           => IsReadOnly("notes");

    // Per-field setters — needed because Razor rejects escaped string
    // literals inside inline lambdas in attributes.
    private void OnServiceNumberChanged(string v)   => SetField("serviceNumber", v);
    private void OnProductNameChanged(string v)     => SetField("productName", v);
    private void OnProductCategoryChanged(ChangeEventArgs e) => SetField("productCategory", e.Value?.ToString() ?? "");
    private void OnCityChanged(string v)            => SetField("city", v);
    private void OnStateChanged(string v)           => SetField("state", v);
    private void OnAddressChanged(string v)         => SetField("address", v);
    private void OnAssigneeChanged(string v)        => SetField("assignee", v);
    private void OnNotesChanged(ChangeEventArgs e)  => SetField("notes", e.Value?.ToString() ?? "");

    private void OpenDeleteConfirm()  => _confirmDelete = true;
    private void CloseDeleteConfirm() => _confirmDelete = false;

    protected override async Task OnParametersSetAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        await LoadAsync(_cts.Token);
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        _loadingInitial = true;
        _terminalErr = null;
        _row = null;
        StateHasChanged();

        try
        {
            _row = await RetryAsync(t => Api.GetAsync(Id, t), ct);
        }
        catch (ApiException ex) { _terminalErr = ex; }
        catch (OperationCanceledException) { }
        finally
        {
            _loadingInitial = false;
            StateHasChanged();
        }
    }

    private void StartEdit()
    {
        if (_row is null) return;
        _draft = new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["serviceNumber"]   = _row.ServiceNumber ?? "",
            ["productName"]     = _row.ProductName ?? "",
            ["productCategory"] = _row.ProductCategory ?? "",
            ["city"]            = _row.City ?? "",
            ["state"]           = _row.State ?? "",
            ["address"]         = _row.Address ?? "",
            ["assignee"]        = _row.Assignee ?? "",
            ["notes"]           = _row.Notes ?? "",
        };
        _fieldErrors.Clear();
        _terminalErr = null;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _draft.Clear();
        _fieldErrors.Clear();
    }

    private void SetField(string name, string value)
    {
        _draft[name] = value;
        _fieldErrors.Remove(name);
    }

    private bool IsReadOnly(string name)
    {
        var admin = Me.Current?.AdminOnlyFields;
        return admin is not null && admin.Contains(name) && Me.EffectiveRole != Role.Admin;
    }

    private string[] FieldErrs(string name) =>
        _fieldErrors.TryGetValue(name, out var arr) ? arr : Array.Empty<string>();

    private async Task SaveEditAsync()
    {
        if (_row is null || _pending) return;

        // Diff against the current row — only send changed fields.
        var patch = new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["rowVersion"] = _row.RowVersion,
        };
        foreach (var name in Writable)
        {
            var current = name switch
            {
                "serviceNumber"   => _row.ServiceNumber ?? "",
                "productName"     => _row.ProductName ?? "",
                "productCategory" => _row.ProductCategory ?? "",
                "city"            => _row.City ?? "",
                "state"           => _row.State ?? "",
                "address"         => _row.Address ?? "",
                "assignee"        => _row.Assignee ?? "",
                "notes"           => _row.Notes ?? "",
                _ => "",
            };
            var draftVal = _draft.TryGetValue(name, out var v) ? v : current;
            if (draftVal == current) continue;
            // Empty string on an optional field = clear (null); the server
            // returns per-field validation for a required field cleared.
            var isOptional = name is "city" or "state" or "address" or "assignee" or "notes";
            patch[name] = draftVal.Length == 0 && isOptional ? null : draftVal;
        }
        if (patch.Count == 1) { CancelEdit(); return; } // rowVersion only — nothing changed

        _pending = true;
        _terminalErr = null;
        StateHasChanged();

        try
        {
            var ct = _cts?.Token ?? CancellationToken.None;
            _row = await Api.PatchInventoryAsync(Id, patch, ct);
            _editing = false;
            _draft.Clear();
            _fieldErrors.Clear();
        }
        catch (ApiException ex)
        {
            var map = Reporter.Report(ex, "Save failed");
            if (map is not null)
            {
                _fieldErrors = new Dictionary<string, string[]>(map, StringComparer.Ordinal);
            }
            if (ex.IsSlug("concurrency-conflict"))
            {
                try { _row = await Api.GetAsync(Id, _cts?.Token ?? CancellationToken.None); }
                catch { /* ignore refetch fail */ }
                Toasts.Error("Row changed while editing — reloaded.");
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Reporter.Report(ex, "Save failed"); }
        finally
        {
            _pending = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAsync()
    {
        if (_row is null || _pending) return;
        _pending = true;
        _confirmDelete = false;
        StateHasChanged();

        try
        {
            var ct = _cts?.Token ?? CancellationToken.None;
            await Api.DeleteInventoryAsync(Id, ct);
            Toasts.Info("Row deleted.");
            await OnClose();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Reporter.Report(ex, "Delete failed"); }
        finally
        {
            _pending = false;
            StateHasChanged();
        }
    }

    private async Task PatchStatusAsync(string status)
    {
        if (_row is null || _pending) return;
        _pending = true;
        _pendingTarget = status;
        _terminalErr = null;
        StateHasChanged();

        try
        {
            var ct = _cts?.Token ?? CancellationToken.None;
            var body = new StatusPatch(status, _row.RowVersion);
            var res = await RetryAsync(t => Api.PatchStatusAsync(Id, body, t), ct);
            _row = await Api.GetAsync(Id, ct);
        }
        catch (ApiException ex)
        {
            _terminalErr = ex;
            if (ex.IsSlug("concurrency-conflict"))
            {
                try { _row = await Api.GetAsync(Id, _cts?.Token ?? CancellationToken.None); }
                catch { /* ignore refetch fail — original err is more useful */ }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _pending = false;
            _pendingTarget = null;
            StateHasChanged();
        }
    }

    private async Task<T> RetryAsync<T>(Func<CancellationToken, Task<T>> op, CancellationToken ct)
    {
        _attempt = 0;
        _recovering = false;
        while (true)
        {
            try
            {
                var r = await op(ct);
                _recovering = false;
                return r;
            }
            catch (ApiException ex) when (ex.StatusCode >= 500 && _attempt < MaxAttempts - 1)
            {
                _attempt++;
                _recovering = true;
                StateHasChanged();
                await Task.Delay(Backoff[Math.Min(_attempt - 1, Backoff.Length - 1)], ct);
            }
            catch (HttpRequestException) when (_attempt < MaxAttempts - 1)
            {
                _attempt++;
                _recovering = true;
                StateHasChanged();
                await Task.Delay(Backoff[Math.Min(_attempt - 1, Backoff.Length - 1)], ct);
            }
        }
    }

    private void OnBackdrop() { if (!_pending && !_editing) _ = OnClose(); }

    private Task OnClose() => OnClosed.InvokeAsync();

    private static string[] NextStatuses(string cur) => cur switch
    {
        "pending"      => new[] { "active", "disconnected" },
        "active"       => new[] { "disconnected" },
        _              => Array.Empty<string>(),
    };

    private static string BtnKind(string s) => s switch
    {
        "disconnected" => "danger",
        "active"       => "ok",
        _              => "",
    };

    private static string MutationTitle(ApiException e) => e.Slug switch
    {
        "invalid-status-transition" => "Transition not allowed",
        "concurrency-conflict"      => "Row changed",
        "not-found"                 => "Row no longer exists",
        "validation-failed"         => "Validation failed",
        "unauthorized"              => "Not authorized",
        "forbidden"                 => "Forbidden",
        _                           => e.StatusCode >= 500 ? "Server error" : "Request failed",
    };

    private static string LocationLine(InventoryRow r) =>
        string.Join(", ", new[] { r.City, r.State }.Where(x => !string.IsNullOrWhiteSpace(x))!) is var s && s.Length > 0 ? s : "—";

    private static string Fmt(DateTimeOffset d) =>
        d.LocalDateTime.ToString("MMM d, yyyy HH:mm");

    public void Dispose() => _cts?.Cancel();
}
