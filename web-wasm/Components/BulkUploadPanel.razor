@inject BruinApiClient Api
@inject TenantContext Tenant
@inject IJSRuntime JS
@inject ToastService Toasts
@inject MeService Me
@implements IDisposable

@* Bulk CSV upload with live progress. Matches the React SPA:
     1. Upload phase — POST the multipart form.
     2. Streaming phase — SSE feed of BulkJobStatus snapshots.
     3. If SSE drops, fall back to polling GET /bulk-jobs/{id}.

   Unlike the React app, HttpClient in Blazor WASM doesn't expose
   upload-progress callbacks (no per-byte XHR-style events), so the
   "uploading" bar is a coarse indeterminate slider instead of a
   real % bar. Once the server accepts the job the SSE frames drive
   an exact progress bar identical to the React one. *@

<div class="bulk-panel">
    <span style="color:var(--slate-500);font-size:11px">Bulk upload</span>

    @* File input + Upload button stay visible for readers but are
       disabled — reviewer letter: "disable controls rather than hide
       them, so the permission model teaches itself." Tooltip explains why. *@
    <InputFile OnChange="OnFilePicked" accept=".csv,text/csv" class="bulk-file"
               disabled="@(!Me.CanWrite)"
               title="@(Me.CanWrite ? null : "Requires admin or worker role")" />

    <button type="button" class="btn" style="font-size:11px;padding:2px 10px;background:var(--slate-800);color:white;border-color:var(--slate-800)"
            disabled="@(!Me.CanWrite || _file is null || _phase is Phase.Uploading or Phase.Streaming or Phase.Polling)"
            title="@(Me.CanWrite ? null : "Requires admin or worker role")"
            @onclick="UploadAsync">Upload</button>

    <a href="javascript:void(0)" @onclick="DownloadTemplateAsync" style="color:var(--indigo-600);font-size:11px;text-decoration:underline">CSV template</a>
    <a href="javascript:void(0)" @onclick="DownloadSampleAsync"
       title="~50 MB stream of realistic rows for load-testing the bulk upload path"
       style="color:var(--indigo-600);font-size:11px;text-decoration:underline">Sample 500k CSV</a>

    @if (_phase == Phase.Uploading && _file is not null)
    {
        <div class="bulk-progress" data-testid="upload-progress">
            <span class="filename">@_file.Name <span style="color:var(--slate-400)">(uploading)</span></span>
            <div class="bar">
                <div class="bar-inner indeterminate"></div>
            </div>
            <span class="tabular" style="color:var(--slate-500)">@FormatBytes(_file.Size)</span>
        </div>
    }
    else if (_job is not null)
    {
        <div class="bulk-progress">
            <span class="filename">@_job.FileName <span style="color:var(--slate-400)">(@PhaseLabel())</span></span>
            <div class="bar">
                <div class="bar-inner" style="width:@Pct(_job)%;background:@BarColor(_job.Status)"></div>
            </div>
            <span class="tabular" style="color:var(--slate-500);width:32px;text-align:right">@Pct(_job)%</span>
            <span class="tabular">
                <span style="color:var(--emerald-700)">@_job.SucceededRows.ToString("N0")</span>
                <span style="color:var(--slate-400)"> ok / </span>
                <span style="color:var(--rose-700)">@_job.FailedRows.ToString("N0")</span>
                <span style="color:var(--slate-400)"> err</span>
            </span>
            <span class="tabular" style="color:var(--slate-500)" title="Rolling rows/sec (last snapshot)">
                @FormatRate(_instantRps) r/s
            </span>
            @if (!IsTerminal(_job.Status) && _avgRps > 0)
            {
                <span class="tabular" style="color:var(--slate-500)" title="ETA at current average rate">
                    ETA @FormatDuration(EtaSec())
                </span>
            }
            @if (IsTerminal(_job.Status))
            {
                <span class="tabular" style="color:var(--slate-500)" title="Total wall-clock elapsed">
                    in @FormatDuration((DateTimeOffset.UtcNow - _startedAt).TotalSeconds)
                </span>
            }
            @if (_job.Status == "completedWithErrors" && !string.IsNullOrEmpty(_job.ErrorSampleUrl))
            {
                <a href="javascript:void(0)" @onclick="() => DownloadErrorSampleAsync(_job)"
                   style="color:var(--indigo-600);font-size:11px;text-decoration:underline">error CSV</a>
            }
            @if (_error is not null)
            {
                <span style="color:var(--rose-700)">@_error</span>
            }
        </div>
    }
</div>


@code {
    private enum Phase { Idle, Uploading, Streaming, Polling, Done, Error }

    private IBrowserFile? _file;
    private Phase _phase = Phase.Idle;
    private BulkJobStatus? _job;
    private string? _error;
    private DateTimeOffset _startedAt;
    private int _lastProcessed;
    private DateTimeOffset _lastSnapAt;
    private double _instantRps;
    private double _avgRps;
    private CancellationTokenSource? _cts;

    private void OnFilePicked(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _error = null;
        _job = null;
        _phase = Phase.Idle;
    }

    private async Task UploadAsync()
    {
        if (_file is null) return;
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        _error = null;
        _job = null;
        _phase = Phase.Uploading;
        _startedAt = DateTimeOffset.UtcNow;
        _lastProcessed = 0;
        _lastSnapAt = _startedAt;
        _instantRps = 0;
        _avgRps = 0;
        StateHasChanged();

        try
        {
            // MaxAllowedSize covers up to 200 MB — matches API cap.
            using var stream = _file.OpenReadStream(maxAllowedSize: 200 * 1024 * 1024, ct);
            var accepted = await Api.PostBulkJobAsync(
                stream, _file.Name, string.IsNullOrEmpty(_file.ContentType) ? "text/csv" : _file.ContentType,
                progress: null, ct);

            _job = new BulkJobStatus(
                JobId: accepted.JobId, Status: accepted.Status, FileName: _file.Name,
                TotalRows: 0, ProcessedRows: 0, SucceededRows: 0, FailedRows: 0,
                ErrorSampleUrl: $"/api/v1/bulk-jobs/{accepted.JobId}/errors");

            await StreamAsync(accepted.JobId, ct);
        }
        catch (OperationCanceledException) { _phase = Phase.Idle; }
        catch (ApiException ex)
        {
            // Pre-accept failures render nothing in the panel (the inline
            // progress row only mounts when `_job` is set), so surface the
            // server's ProblemDetails through the toaster instead.
            _error = ex.Problem.Detail ?? ex.Problem.Title ?? "upload failed";
            _phase = Phase.Error;
            Toasts.Error($"Upload failed — {_error}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _phase = Phase.Error;
            Toasts.Error($"Upload failed — {_error}");
        }
        finally { StateHasChanged(); }
    }

    private async Task StreamAsync(string jobId, CancellationToken ct)
    {
        _phase = Phase.Streaming;
        StateHasChanged();
        try
        {
            await foreach (var snap in Api.StreamBulkJobEventsAsync(jobId, ct))
            {
                UpdateRate(snap);
                _job = snap;
                StateHasChanged();
                if (IsTerminal(snap.Status))
                {
                    _phase = Phase.Done;
                    StateHasChanged();
                    await MaybeToastJobLevelFailureAsync(snap, ct);
                    return;
                }
            }
            // Stream ended without a terminal frame — fall back to polling.
            await PollAsync(jobId, ct);
        }
        catch (OperationCanceledException) { _phase = Phase.Idle; }
        catch
        {
            // Any SSE hiccup — fall through to polling instead of failing.
            await PollAsync(jobId, ct);
        }
    }

    private async Task PollAsync(string jobId, CancellationToken ct)
    {
        _phase = Phase.Polling;
        StateHasChanged();
        for (var i = 0; i < 240; i++)
        {
            try
            {
                var snap = await Api.GetBulkJobAsync(jobId, ct);
                UpdateRate(snap);
                _job = snap;
                StateHasChanged();
                if (IsTerminal(snap.Status))
                {
                    _phase = Phase.Done;
                    StateHasChanged();
                    await MaybeToastJobLevelFailureAsync(snap, ct);
                    return;
                }
            }
            catch { /* keep polling */ }
            await Task.Delay(500, ct);
        }
        _error = "polling timeout — check job status manually";
        _phase = Phase.Error;
        StateHasChanged();
    }

    // Terminal-status → toaster.
    //   status=failed              → job-level reason (rowNumber=0). Written
    //                                by BulkJobRunner.MarkFailedAsync when
    //                                the file is malformed at whole-file
    //                                level (bad header, empty file, etc).
    //   status=completedWithErrors → preview the first few row errors. The
    //                                full list is still one click away via
    //                                the "error CSV" link, so we cap the
    //                                toast at 3 rows to keep it readable.
    // Silent on status=completed.
    private async Task MaybeToastJobLevelFailureAsync(BulkJobStatus snap, CancellationToken ct)
    {
        if (snap.Status != "failed" && snap.Status != "completedWithErrors") return;
        try
        {
            var body = await Api.GetBulkJobErrorsAsync(snap.JobId, ct);
            var all = body.Errors;

            if (snap.Status == "failed")
            {
                var jobLevel = all.Where(e => e.RowNumber == 0).ToArray();
                var reason = jobLevel.Length > 0
                    ? string.Join("; ", jobLevel.Select(e => e.Reason))
                    : "Job failed with no reason recorded.";
                Toasts.Error($"Job failed — {reason}");
                return;
            }

            // completedWithErrors
            var rowErrors = all.Where(e => e.RowNumber > 0).ToArray();
            if (rowErrors.Length == 0) return;
            var preview = string.Join("\n", rowErrors.Take(3).Select(e =>
                $"row {e.RowNumber}{(string.IsNullOrEmpty(e.ServiceNumber) ? "" : $" ({e.ServiceNumber})")}: {e.Reason}"));
            // Prefer the server's authoritative FailedRows over rowErrors.Length —
            // the /errors endpoint caps at 500 entries.
            var total = snap.FailedRows > 0 ? snap.FailedRows : rowErrors.Length;
            var remaining = total - Math.Min(3, rowErrors.Length);
            var suffix = remaining > 0 ? $"\n…and {remaining} more (see error CSV)" : "";
            Toasts.Error($"{total} row{(total == 1 ? "" : "s")} failed:\n{preview}{suffix}", 15000);
        }
        catch
        {
            Toasts.Error("Job errors — could not fetch details.");
        }
    }

    private void UpdateRate(BulkJobStatus snap)
    {
        var now = DateTimeOffset.UtcNow;
        var dSec = Math.Max(0.001, (now - _lastSnapAt).TotalSeconds);
        var dRows = Math.Max(0, snap.ProcessedRows - _lastProcessed);
        _instantRps = dRows / dSec;
        var elapsedSec = Math.Max(0.001, (now - _startedAt).TotalSeconds);
        _avgRps = snap.ProcessedRows / elapsedSec;
        _lastProcessed = snap.ProcessedRows;
        _lastSnapAt = now;
    }

    private double EtaSec()
    {
        if (_job is null || _avgRps <= 0) return 0;
        var total = Math.Max(_job.TotalRows, _job.ProcessedRows);
        var remaining = Math.Max(0, total - _job.ProcessedRows);
        return remaining / _avgRps;
    }

    private static int Pct(BulkJobStatus j)
    {
        var total = Math.Max(Math.Max(j.TotalRows, j.ProcessedRows), 1);
        return Math.Min(100, (int)Math.Round(100.0 * j.ProcessedRows / total));
    }

    private static string BarColor(string status) => status switch
    {
        "failed"              => "var(--rose-500)",
        "completedWithErrors" => "#f59e0b",
        "completed"           => "#10b981",
        _                     => "var(--indigo-500)",
    };

    private static bool IsTerminal(string s) =>
        s is "completed" or "completedWithErrors" or "failed";

    // Show the server's terminal status once the job ends — otherwise the
    // label reads "done" for every ending, indistinguishable from success.
    private string PhaseLabel() =>
        _job is not null && IsTerminal(_job.Status)
            ? _job.Status
            : _phase.ToString().ToLowerInvariant();

    private static string FormatBytes(long n)
    {
        if (n >= 1024 * 1024) return $"{n / 1024.0 / 1024.0:F1} MB";
        if (n >= 1024)        return $"{n / 1024.0:F1} KB";
        return $"{n} B";
    }
    private static string FormatRate(double v)
    {
        if (v >= 10_000) return $"{v / 1000:F1}k";
        if (v >= 1_000)  return $"{v / 1000:F2}k";
        return v < 1 ? "0" : Math.Round(v).ToString();
    }
    private static string FormatDuration(double sec)
    {
        if (double.IsNaN(sec) || sec < 0) return "—";
        if (sec < 60)   return $"{Math.Round(sec)}s";
        if (sec < 3600) return $"{(int)(sec / 60)}m {(int)(sec % 60)}s";
        return $"{(int)(sec / 3600)}h {(int)((sec % 3600) / 60)}m";
    }

    private async Task DownloadTemplateAsync() =>
        await JS.InvokeVoidAsync("bruinDownload.fromUrl", "/api/v1/inventory/csv-template", Tenant.Current.ApiKey, "inventory-template.csv");

    private async Task DownloadSampleAsync() =>
        await JS.InvokeVoidAsync("bruinDownload.fromUrl", "/api/v1/inventory/csv-sample?rows=500000", Tenant.Current.ApiKey, "bruin-sample-500k.csv");

    private async Task DownloadErrorSampleAsync(BulkJobStatus j)
    {
        if (string.IsNullOrEmpty(j.ErrorSampleUrl)) return;
        await JS.InvokeVoidAsync("bruinDownload.fromUrl", j.ErrorSampleUrl, Tenant.Current.ApiKey, $"bruin-errors-{j.JobId}.csv");
    }

    public void Dispose() => _cts?.Cancel();
}
