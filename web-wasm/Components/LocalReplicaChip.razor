@inject LocalReplica Replica
@inject TenantContext Tenant
@implements IDisposable

@* Compact status chip + mode toggle for the local SQLite replica. Sits
   inline in the grid's stats row so a reviewer can flip between server
   and local reads without leaving the page.

   States:
     - Not open              → nothing to show (pre-tenant boot)
     - Open, empty           → "Hydrate" button (kicks off snapshot pull)
     - Hydrating             → spinner + "Batches: N · Rows: N"
     - Ready                 → toggle (Server | Local) + row count + age *@

<div class="lr-chip @ChipModeClass()">
    @if (!Replica.IsOpen)
    {
        <span class="lr-muted">local · idle</span>
    }
    else if (!Replica.IsReady && !_hydrating)
    {
        <button class="btn btn-mini" @onclick="StartHydrate" title="Populate the local SQLite mirror from the server snapshot feed">
            Hydrate local
        </button>
    }
    else if (_hydrating)
    {
        <span class="lr-spinner"></span>
        <span>hydrating · @_batches batches · @_rowsThisRun rows</span>
        <button class="btn btn-mini btn-ghost" @onclick="CancelHydrate">Cancel</button>
    }
    else
    {
        <div class="lr-seg" role="group" aria-label="Read source">
            <button class="lr-seg-server @(Mode == "server" ? "lr-seg-on" : "")"
                    @onclick='() => SetMode("server")'
                    aria-pressed="@(Mode == "server" ? "true" : "false")">Server</button>
            <button class="lr-seg-local @(Mode == "local"  ? "lr-seg-on" : "")"
                    @onclick='() => SetMode("local")'
                    aria-pressed="@(Mode == "local"  ? "true" : "false")">Local</button>
        </div>
        <span class="lr-meta" title="@SliceTooltip()">
            @SliceLabel() · synced @AgeLabel()
        </span>
        <button class="btn btn-mini btn-ghost" @onclick="StartHydrate"
                title="Pull any rows updated since the last sync">Sync</button>
    }
</div>

<style>
    /* The whole chip is tinted by mode so a glance tells you which read
       path is active. Green = local (warm cache, off-network). Blue =
       server (source of truth). Yellow = mid-hydration. */
    .lr-chip {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 4px 8px; border-radius: 6px;
        border: 1px solid transparent;
        font-size: 12px; color: var(--slate-700);
        transition: background 120ms ease-out, border-color 120ms ease-out;
    }
    .lr-chip.lr-mode-server { background: #eff6ff; border-color: #bfdbfe; }
    .lr-chip.lr-mode-local  { background: #ecfdf5; border-color: #a7f3d0; }
    .lr-chip.lr-busy        { background: #fef9c3; border-color: #fde68a; }
    .lr-muted { color: var(--slate-400); font-style: italic; }
    .lr-meta { color: var(--slate-500); font-variant-numeric: tabular-nums; }

    /* Segmented Server/Local toggle. Inactive is a hairline chip; active
       flips to a strong fill in the mode's accent color so it reads at a
       glance even in peripheral vision. */
    .lr-seg {
        display: inline-flex; border: 1px solid var(--slate-300);
        border-radius: 5px; overflow: hidden;
    }
    .lr-seg button {
        background: transparent; border: 0; padding: 2px 10px;
        font-size: 11px; cursor: pointer; color: var(--slate-600);
        font-weight: 500; letter-spacing: 0.02em;
    }
    .lr-seg button:hover { background: rgba(15, 23, 42, 0.05); }
    .lr-seg .lr-seg-server.lr-seg-on {
        background: #2563eb; color: white;
        box-shadow: inset 0 -2px 0 #1d4ed8;
    }
    .lr-seg .lr-seg-local.lr-seg-on {
        background: #10b981; color: white;
        box-shadow: inset 0 -2px 0 #059669;
    }
    .lr-seg button:focus-visible {
        outline: 2px solid #2563eb; outline-offset: 1px;
    }
    .btn-mini { padding: 2px 8px; font-size: 11px; }
    .btn-ghost { background: transparent; border: 1px solid transparent; color: var(--slate-500); }
    .btn-ghost:hover { border-color: var(--slate-300); }
    .lr-spinner {
        width: 10px; height: 10px; border-radius: 50%;
        border: 2px solid var(--slate-300); border-top-color: var(--slate-700);
        animation: lr-spin 0.7s linear infinite;
    }
    @@keyframes lr-spin { to { transform: rotate(360deg); } }
</style>

@code {
    [Parameter] public string Mode { get; set; } = "server";
    [Parameter] public EventCallback<string> ModeChanged { get; set; }

    private bool _hydrating;
    private int _batches;
    private long _rowsThisRun;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized()
    {
        Replica.Changed += OnReplicaChanged;
        Tenant.OnChanged += OnTenantChanged;
        // Kick off open on first render (needs to be async, defer).
        _ = EnsureOpenAsync(autoSyncIfPopulated: true);
    }

    private void OnTenantChanged()
    {
        // Tenant flipped — open the destination mirror and, if it already
        // has rows persisted from a prior session (OPFS), sync deltas
        // automatically. Fresh mirrors still require a manual Hydrate
        // click so an operator never triggers a surprise ~30s pull.
        _ = InvokeAsync(async () =>
        {
            await EnsureOpenAsync(autoSyncIfPopulated: true);
            StateHasChanged();
        });
    }

    private async Task EnsureOpenAsync(bool autoSyncIfPopulated = false)
    {
        var cid = ResolveClientId();
        if (cid is Guid g && Replica.ClientId != g)
        {
            try { await Replica.OpenAsync(g); }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"LocalReplica open failed: {ex.Message}");
                return;
            }
        }
        // Post-open: if the mirror is non-empty and we're not already
        // hydrating, kick a background sync so a returning operator gets
        // fresh deltas without waiting for a click. Non-blocking; the
        // hydrating spinner narrates the state.
        if (autoSyncIfPopulated && Replica.IsReady && !_hydrating)
        {
            _ = StartHydrate();
        }
    }

    // /me hasn't landed yet when this component first mounts, so derive
    // client id from the tenant label. We namespace the local DB by this
    // value; when /me eventually lands the router won't need it — the
    // server still owns tenant auth.
    private Guid? ResolveClientId()
    {
        // Deterministic pseudo-Guid from the tenant slug so a repeat visit
        // reuses the same OPFS file. Not a security boundary — the server
        // still gates every request by X-Api-Key.
        var slug = Tenant.Current.Id;
        var bytes = new byte[16];
        var src = System.Text.Encoding.UTF8.GetBytes(slug);
        Array.Copy(src, bytes, Math.Min(src.Length, 16));
        return new Guid(bytes);
    }

    private void OnReplicaChanged() => InvokeAsync(StateHasChanged);

    private async Task StartHydrate()
    {
        await EnsureOpenAsync();
        if (_hydrating) return;
        _hydrating = true;
        _batches = 0;
        _rowsThisRun = 0;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        var progress = new Progress<HydrationProgress>(p =>
        {
            _batches = p.Batches;
            _rowsThisRun = p.RowsThisRun;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await Replica.HydrateAsync(progress, ct: _cts.Token);
            // On first successful hydrate, flip the caller into local mode
            // automatically — that's the whole point of the panel.
            if (Mode != "local" && Replica.IsReady)
            {
                await ModeChanged.InvokeAsync("local");
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Hydrate failed: {ex.Message}");
        }
        finally
        {
            _hydrating = false;
            _cts = null;
            StateHasChanged();
        }
    }

    private void CancelHydrate() { _cts?.Cancel(); }

    private async Task SetMode(string next)
    {
        if (Mode == next) return;
        await ModeChanged.InvokeAsync(next);
    }

    private string ChipModeClass()
    {
        if (_hydrating) return "lr-busy";
        if (!Replica.IsReady) return string.Empty;
        return Mode == "local" ? "lr-mode-local" : "lr-mode-server";
    }

    private string SliceLabel()
    {
        var local = Replica.RowCount.ToString("N0");
        var server = Replica.ServerRowsHint;
        // Only annotate as "recent slice" when the local mirror is smaller
        // than the tenant total — otherwise we've hydrated everything and
        // the qualifier would be misleading.
        if (server is long total && Replica.RowCount < total)
            return $"{local} of {total:N0} · recent";
        return $"{local} rows";
    }

    private string SliceTooltip()
    {
        var server = Replica.ServerRowsHint;
        if (server is long total && Replica.RowCount < total)
            return "Local mirror holds the most-recently-updated rows. " +
                   "Filters and search run against this slice only.";
        return "Local mirror covers the entire tenant.";
    }

    private string AgeLabel()
    {
        var since = Replica.LastSyncAt;
        if (since is null) return "—";
        var s = (int)(DateTimeOffset.UtcNow - since.Value).TotalSeconds;
        if (s < 5)   return "just now";
        if (s < 60)  return $"{s}s ago";
        if (s < 3600) return $"{s / 60}m ago";
        return $"{s / 3600}h ago";
    }

    public void Dispose()
    {
        Replica.Changed -= OnReplicaChanged;
        Tenant.OnChanged -= OnTenantChanged;
        _cts?.Cancel();
    }
}
