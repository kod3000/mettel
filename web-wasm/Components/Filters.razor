@implements IDisposable

@* Filter + sort + search bar. Emits a single ValueChanged with the full
   ListParams so the parent holds one source of truth. Search debounces
   at 300ms — same figure as the React SPA + design doc. Category and
   status vocabularies mirror the React `apps/web/src/components/Filters.tsx`
   and the API seed data. *@

<div class="filters">
    <input
        type="search"
        class="input search"
        placeholder="Search service #, product, address…"
        value="@_q"
        @oninput="OnSearchInput"
        aria-label="Search inventory" />

    @* "Search in" chips — mirror apps/web/src/components/Filters.tsx.
       Always visible so operators discover them; muted opacity when the
       query is empty (toggles pre-apply for the next search). *@
    <fieldset class="search-in-group @(string.IsNullOrWhiteSpace(_q) ? "muted" : "")"
              title="Restrict the search to specific columns. All-on uses the fast tsvector index; any deselected falls back to per-column ILIKE.">
        <legend>Search in</legend>
        @foreach (var f in SearchFields)
        {
            var on = ActiveFields().Contains(f.Wire);
            <button type="button" class="search-in-chip @(on ? "on" : "off")"
                    title="@f.Title" @onclick="() => ToggleField(f.Wire)">
                @f.Label
            </button>
        }
    </fieldset>

    <FilterGroup Label="Status" Options="Statuses" Selected="Value.Status"
                 OnToggle="s => ToggleStatus(s)" />

    <FilterGroup Label="Category" Options="Categories" Selected="Value.ProductCategory"
                 OnToggle="c => ToggleCategory(c)" />

    @if (HasActiveFilters())
    {
        <button type="button" class="btn" style="font-size:11px;padding:2px 8px"
                @onclick="ClearAsync" title="Reset q + status + category + state">
            Clear filters
        </button>
    }

    <div style="display:flex;align-items:center;gap:6px;margin-left:auto;font-size:11px;color:var(--slate-600)">
        <span>Sort</span>
        <select class="select" style="height:26px;font-size:11px" value="@(Value.Sort ?? "createdAt")"
                @onchange="OnSortKey">
            @foreach (var k in SortKeys)
            {
                <option value="@k">@k</option>
            }
        </select>
        <select class="select" style="height:26px;font-size:11px" value="@(Value.Dir ?? "desc")"
                @onchange="OnSortDir">
            <option value="desc">desc</option>
            <option value="asc">asc</option>
        </select>
    </div>
</div>


@code {
    [Parameter, EditorRequired] public BruinApiClient.ListParams Value { get; set; } = default!;
    [Parameter] public EventCallback<BruinApiClient.ListParams> ValueChanged { get; set; }

    // Vocabularies mirror React's Filters.tsx exactly.
    private static readonly string[] Statuses   = { "pending", "active", "disconnected" };
    private static readonly string[] Categories = { "voice", "data", "wireless", "other" };
    private static readonly string[] SortKeys   = { "createdAt", "updatedAt", "status", "serviceNumber", "productName" };

    private sealed record SearchField(string Wire, string Label, string Title);
    private static readonly SearchField[] SearchFields = {
        new("productName",   "product",  "Match against product name"),
        new("serviceNumber", "service#", "Match against service number"),
        new("city",          "city",     "Match against city"),
        new("state",         "state",    "Match against state"),
        new("address",       "address",  "Match against address"),
        new("assignee",      "assignee", "Match against assignee"),
        new("notes",         "notes",    "Match against notes"),
    };
    private static readonly string[] AllFieldWires = SearchFields.Select(f => f.Wire).ToArray();

    // A chip is "on" when its wire name is in the active set. Undefined
    // Fields (default) = all on (broad tsvector). Toggling any chip off
    // crystalizes the current all-set into the list.
    private IReadOnlyCollection<string> ActiveFields()
        => Value.Fields ?? AllFieldWires;

    private Task ToggleField(string wire)
    {
        var current = ActiveFields();
        var next = new List<string>(current);
        if (!next.Remove(wire)) next.Add(wire);
        // If all fields are on, drop the param → API uses the fast tsvector path.
        var allOn = AllFieldWires.All(next.Contains);
        return Emit(Value with { Fields = allOn ? null : next, Cursor = null });
    }

    private string _q = "";
    private System.Timers.Timer? _debounce;

    protected override void OnParametersSet() => _q = Value.Q ?? "";

    private void OnSearchInput(ChangeEventArgs e)
    {
        _q = e.Value?.ToString() ?? "";
        _debounce?.Stop();
        _debounce ??= new System.Timers.Timer(300) { AutoReset = false };
        _debounce.Elapsed -= FireSearch;
        _debounce.Elapsed += FireSearch;
        _debounce.Start();
    }

    private async void FireSearch(object? _, System.Timers.ElapsedEventArgs __)
    {
        var trimmed = _q.Trim();
        if (trimmed == (Value.Q ?? "").Trim()) return;
        await InvokeAsync(() => Emit(Value with { Q = string.IsNullOrEmpty(trimmed) ? null : trimmed, Cursor = null }));
    }

    private Task ToggleStatus(string s) => Emit(Value with { Status = Toggle(Value.Status, s), Cursor = null });
    private Task ToggleCategory(string c) => Emit(Value with { ProductCategory = Toggle(Value.ProductCategory, c), Cursor = null });

    private Task OnSortKey(ChangeEventArgs e)   => Emit(Value with { Sort = e.Value?.ToString(), Cursor = null });
    private Task OnSortDir(ChangeEventArgs e)   => Emit(Value with { Dir  = e.Value?.ToString(), Cursor = null });

    private bool HasActiveFilters() =>
        !string.IsNullOrWhiteSpace(Value.Q)
        || (Value.Status?.Count ?? 0) > 0
        || (Value.ProductCategory?.Count ?? 0) > 0
        || (Value.State?.Count ?? 0) > 0;

    private Task ClearAsync()
    {
        _q = "";
        return Emit(Value with { Q = null, Fields = null, Status = null, ProductCategory = null, State = null, Cursor = null });
    }

    private static IReadOnlyCollection<string>? Toggle(IReadOnlyCollection<string>? cur, string val)
    {
        var next = cur is null ? new List<string>() : new List<string>(cur);
        if (!next.Remove(val)) next.Add(val);
        return next.Count == 0 ? null : next;
    }

    private Task Emit(BruinApiClient.ListParams next) => ValueChanged.InvokeAsync(next);

    public void Dispose()
    {
        _debounce?.Stop();
        _debounce?.Dispose();
    }
}
