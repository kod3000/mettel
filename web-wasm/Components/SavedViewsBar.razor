@inject BruinApiClient Api
@inject MeService Me
@implements IDisposable

@* Persistent named filter presets — GET /api/v1/saved-views on mount,
   POST on save, DELETE on ×. Filters are shipped as an opaque JSON
   string so the server doesn't care about the shape; the client owns
   the schema.

   Note: the React SPA persists the last-applied view id in
   localStorage; skipped here because it's a nice-to-have not required
   for feature parity of the visible UX. *@

<div class="saved-views">
    <span style="color:var(--slate-500);font-size:11px">Saved views</span>

    @if (_loading)
    {
        <span style="color:var(--slate-400);font-size:11px;font-style:italic">Loading…</span>
    }
    else if (_views.Count == 0)
    {
        <span style="color:var(--slate-400);font-size:11px;font-style:italic">none yet</span>
    }
    else
    {
        @foreach (var v in _views)
        {
            <span class="saved-chip">
                <button type="button" class="saved-name" @onclick="() => Apply(v)">@v.Name</button>
                @if (Me.CanWrite)
                {
                    <button type="button" class="saved-del" @onclick="() => DeleteAsync(v)" title="Delete">×</button>
                }
            </span>
        }
    }

    <div style="flex:1"></div>

    @if (Me.CanWrite)
    {
        <input type="text" class="input" style="width:220px;height:26px;font-size:11px"
               placeholder="Save current filters as…"
               value="@_name"
               @oninput="OnNameInput" />
        <button type="button" class="btn" style="font-size:11px;padding:2px 10px;background:var(--slate-800);color:white;border-color:var(--slate-800)"
                disabled="@(_saving || string.IsNullOrWhiteSpace(_name))"
                @onclick="SaveAsync">Save</button>
    }
</div>

<style>
    .saved-views {
        display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
        padding: 6px 16px; background: var(--slate-50);
        border-bottom: 1px solid var(--slate-200); font-size: 11px;
    }
    .saved-chip {
        display: inline-flex; align-items: center; gap: 4px;
        background: white; border: 1px solid var(--slate-200);
        border-radius: 999px; padding: 1px 8px;
    }
    .saved-name { background: none; border: none; padding: 0; font-weight: 500; color: var(--slate-700); cursor: pointer; }
    .saved-name:hover { color: var(--indigo-600); }
    .saved-del  { background: none; border: none; padding: 0; color: var(--slate-400); cursor: pointer; }
    .saved-del:hover { color: var(--rose-500); }
</style>

@code {
    [Parameter, EditorRequired] public BruinApiClient.ListParams Params { get; set; } = default!;
    [Parameter] public EventCallback<BruinApiClient.ListParams> OnApply { get; set; }

    private readonly List<SavedView> _views = new();
    private bool _loading = true;
    private bool _saving;
    private string _name = "";
    private CancellationTokenSource? _cts;

    private void OnNameInput(ChangeEventArgs e) => _name = e.Value?.ToString() ?? "";

    private static readonly System.Text.Json.JsonSerializerOptions Json = new(System.Text.Json.JsonSerializerDefaults.Web);

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var list = await Api.ListSavedViewsAsync(_cts!.Token);
            _views.Clear();
            _views.AddRange(list.Views);
        }
        catch { /* swallow — bar renders empty state */ }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var body = new SavedViewUpsert(
                Name: _name.Trim(),
                Filters: System.Text.Json.JsonSerializer.Serialize(SerializeParams(Params), Json),
                Sort: System.Text.Json.JsonSerializer.Serialize(new { sort = Params.Sort, dir = Params.Dir }, Json),
                Columns: "{}");
            var created = await Api.CreateSavedViewAsync(body, _cts!.Token);
            _views.Add(created);
            _name = "";
        }
        catch { /* leave the input filled so the user can retry */ }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAsync(SavedView v)
    {
        if (v.Id is null) return;
        try
        {
            await Api.DeleteSavedViewAsync(v.Id, _cts!.Token);
            _views.Remove(v);
        }
        catch { /* ignore — reloading on next mount will resync */ }
        StateHasChanged();
    }

    private async Task Apply(SavedView v)
    {
        try
        {
            var restored = System.Text.Json.JsonSerializer.Deserialize<SerializedParams>(v.Filters, Json);
            if (restored is not null)
            {
                await OnApply.InvokeAsync(new BruinApiClient.ListParams(
                    Q: restored.Q,
                    Status: restored.Status,
                    ProductCategory: restored.ProductCategory,
                    State: restored.State,
                    Sort: restored.Sort,
                    Dir: restored.Dir,
                    PageSize: restored.PageSize ?? 100,
                    Cursor: null));
            }
        }
        catch { /* malformed view — ignore */ }
    }

    // The React SPA persists `ListParams` verbatim as JSON. We normalize
    // to a small serializable record so future field additions on the
    // C# side don't leak into the wire shape unintentionally.
    private static SerializedParams SerializeParams(BruinApiClient.ListParams p) => new(
        Q: p.Q,
        Status: p.Status?.ToArray(),
        ProductCategory: p.ProductCategory?.ToArray(),
        State: p.State?.ToArray(),
        Sort: p.Sort,
        Dir: p.Dir,
        PageSize: p.PageSize);

    private sealed record SerializedParams(
        string? Q, string[]? Status, string[]? ProductCategory, string[]? State,
        string? Sort, string? Dir, int? PageSize);

    public void Dispose() => _cts?.Cancel();
}
