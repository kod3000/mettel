@inject BruinApiClient Api
@inject LocalReplica Replica
@inject IJSRuntime JS
@implements IDisposable

@* Virtualized inventory grid backed by keyset-cursor pagination. Loads
   the first page on parameter change, appends subsequent pages when the
   user scrolls near the end. Uses Blazor's built-in <Virtualize> for
   windowed rendering — comparable to @tanstack/react-virtual on the
   React side.

   Columns are dynamic: ColumnPicker toggles visibility, `_visibility`
   filters both the header and each row. When search matches a row via
   a hidden field, a small chip surfaces at the row's right edge so the
   operator can see why the row appeared. *@

<div class="grid-stats-row">
    <div style="flex:1">
        <CountDisplay Filtered="_filtered" Total="_total" TookMs="_tookMs" />
    </div>
    <LocalReplicaChip Mode="_mode" ModeChanged="OnModeChanged" />
    <ColumnPicker Columns="PickerColumns" Visible="_visibility" VisibleChanged="OnVisibilityChanged" />
</div>

<div class="grid-wrap">
    <div class="grid-header" style="grid-template-columns:@GridTemplate();min-width:@MinTableWidth()">
        @foreach (var col in VisibleColumns())
        {
            var sorted = Value.Sort == col.SortKey;
            <div class="col @(sorted ? "sorted" : "") @(col.SortKey is null ? "no-sort" : "")"
                 @onclick="() => OnSortClick(col)">
                @col.Label
                @if (sorted)
                {
                    <span class="sort-ind">@(Value.Dir == "asc" ? "▲" : "▼")</span>
                }
            </div>
        }
    </div>

    <div class="grid-scroll" @ref="_scrollRef" @onscroll="OnScroll">
        @if (_error is not null)
        {
            <div class="err-box" style="margin:12px">
                <strong>@(_error.Problem.Title ?? "Failed to load")</strong>
                @if (_error.Problem.Detail is not null) { <div>@_error.Problem.Detail</div> }
                <button class="btn" style="margin-top:8px" @onclick="ReloadAsync">Retry</button>
            </div>
        }
        else
        {
            <Virtualize @ref="_virtualize" Items="_rows" ItemSize="32" OverscanCount="10" Context="row">
                @{
                    var hiddenHits = HiddenMatchesFor(row);
                }
                <div class="grid-row @(row.Id == SelectedId ? "selected" : "")"
                     style="grid-template-columns:@GridTemplate();min-width:@MinTableWidth();position:relative"
                     @onclick="() => OnRowClick.InvokeAsync(row)">
                    @foreach (var col in VisibleColumns())
                    {
                        <div class="@col.CellCssClass">@RenderCell(row, col.Id)</div>
                    }
                    @if (hiddenHits.Count > 0)
                    {
                        <span class="hidden-match-chip"
                              title="@BuildHiddenMatchTooltip(row, hiddenHits)"
                              @onclick:stopPropagation="true">
                            matched: @string.Join(", ", hiddenHits)
                        </span>
                    }
                </div>
            </Virtualize>

            @if (_loadingMore)
            {
                <div style="padding:10px;text-align:center;font-size:12px;color:var(--slate-500)">
                    Loading more…
                </div>
            }
            else if (!_hasMore && _rows.Count > 0)
            {
                <div style="padding:10px;text-align:center;font-size:12px;color:var(--slate-400)">
                    End of results
                </div>
            }
        }
    </div>
</div>

<style>
    .grid-stats-row {
        display: flex; align-items: center; gap: 12px;
        padding: 6px 16px; border-bottom: 1px solid var(--slate-100);
    }
    .grid-header .col.no-sort { cursor: default; }
    .hidden-match-chip {
        position: absolute; right: 8px; top: 50%;
        transform: translateY(-50%);
        display: inline-flex; align-items: center; gap: 4px;
        background: #fffbeb; color: #92400e;
        border: 1px solid #fde68a; border-radius: 999px;
        padding: 1px 8px; font-size: 10px; font-weight: 500;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
        pointer-events: auto;
    }
</style>

@code {
    [Parameter, EditorRequired] public BruinApiClient.ListParams Value { get; set; } = default!;
    [Parameter] public EventCallback<BruinApiClient.ListParams> ValueChanged { get; set; }
    [Parameter] public EventCallback<InventoryRow> OnRowClick { get; set; }
    [Parameter] public string? SelectedId { get; set; }

    private readonly List<InventoryRow> _rows = new();
    private string? _nextCursor;
    private bool _hasMore;
    private bool _loadingMore;
    private CountEnvelope? _filtered;
    private CountEnvelope? _total;
    private long? _tookMs;
    private ApiException? _error;
    private CancellationTokenSource? _cts;
    private ElementReference _scrollRef;
    private Virtualize<InventoryRow>? _virtualize;
    private string _appliedKey = "";

    // "server" | "local" — set by LocalReplicaChip. Local uses SQLite-WASM
    // for zero-latency filter/sort/search over the hydrated tenant slice;
    // server hits /api/v1/inventory as before. Local is offset-paginated
    // (keyset would be overkill for an indexed in-browser DB).
    private string _mode = "server";
    private int _localOffset;
    private long _localFilteredCount;

    private async Task OnModeChanged(string next)
    {
        if (_mode == next) return;
        _mode = next;
        await ReloadAsync();
    }

    // Column visibility — in-memory. Persisting to localStorage would need
    // IJSRuntime interop on init; skipped for scope since a demo browser
    // typically doesn't refresh mid-session. Default = all on.
    private Dictionary<string, bool> _visibility = new();

    // Column metadata: id, label, min width, css class for the cell body,
    // sort key on the server (null = unsortable). One row per grid column.
    private sealed record Col(
        string Id, string Label, string Width, string CellCssClass,
        string? SortKey, bool Required = false);

    private static readonly Col[] AllColumns =
    {
        new("serviceNumber",   "Service #",  "minmax(140px, 180px)",           "mono truncate", "serviceNumber"),
        new("productName",     "Product",    "minmax(220px, 2fr)",             "truncate",      "productName", Required: true),
        new("productCategory", "Category",   "minmax(100px, 130px)",           "truncate",      null),
        new("status",          "Status",     "minmax(120px, 140px)",           "",              "status"),
        new("city",            "City",       "minmax(120px, 160px)",           "truncate",      null),
        new("state",           "State",      "minmax(60px, 80px)",             "mono",          null),
        new("address",         "Address",    "minmax(180px, 1.5fr)",           "truncate",      null),
        new("assignee",        "Assignee",   "minmax(100px, 140px)",           "mono truncate", null),
        new("createdAt",       "Created",    "minmax(150px, 180px)",           "tabular",       "createdAt"),
        new("updatedAt",       "Updated",    "minmax(150px, 180px)",           "tabular",       "updatedAt"),
    };

    private static readonly IReadOnlyList<ColumnPicker.ColumnDef> PickerColumns =
        AllColumns.Select(c => new ColumnPicker.ColumnDef(c.Id, c.Label, c.Required)).ToList();

    // Searchable field wires — mirrors Filters.SearchFields. Notes is
    // included even though there's no grid column for it, so notes hits
    // always chip as "matched: notes".
    private static readonly string[] DefaultSearchFields =
    {
        "productName", "serviceNumber", "city", "state", "address", "assignee", "notes",
    };

    private IEnumerable<Col> VisibleColumns() =>
        AllColumns.Where(c => !_visibility.TryGetValue(c.Id, out var v) || v);

    private string GridTemplate() =>
        string.Join(' ', VisibleColumns().Select(c => c.Width));

    private string MinTableWidth()
    {
        // Sum of numeric min widths (px) — rough enough for horizontal scroll.
        int total = 0;
        foreach (var c in VisibleColumns())
        {
            var m = System.Text.RegularExpressions.Regex.Match(c.Width, @"minmax\((\d+)px");
            total += m.Success ? int.Parse(m.Groups[1].Value) : 180;
        }
        return $"{Math.Max(total + 100, 400)}px";
    }

    private async Task OnVisibilityChanged(Dictionary<string, bool> next)
    {
        _visibility = next;
        StateHasChanged();
        // Re-render virtualized rows — column count may have changed.
        if (_virtualize is not null) await _virtualize.RefreshDataAsync();
    }

    // ---- Cell rendering per column id ---------------------------------

    private RenderFragment RenderCell(InventoryRow row, string colId) => builder =>
    {
        switch (colId)
        {
            case "serviceNumber":   builder.AddContent(0, row.ServiceNumber); break;
            case "productName":     builder.AddContent(0, row.ProductName); break;
            case "productCategory": builder.AddContent(0, row.ProductCategory); break;
            case "status":
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", $"badge {row.Status}");
                builder.AddContent(2, row.Status);
                builder.CloseElement();
                break;
            case "city":            builder.AddContent(0, row.City ?? "—"); break;
            case "state":           builder.AddContent(0, row.State ?? "—"); break;
            case "address":         builder.AddContent(0, row.Address ?? "—"); break;
            case "assignee":        builder.AddContent(0, row.Assignee ?? "—"); break;
            case "createdAt":       builder.AddContent(0, Fmt(row.CreatedAt)); break;
            case "updatedAt":       builder.AddContent(0, Fmt(row.UpdatedAt)); break;
        }
    };

    // ---- Hidden-field match hint --------------------------------------

    private List<string> HiddenMatchesFor(InventoryRow row)
    {
        var q = (Value.Q ?? "").Trim().ToLowerInvariant();
        if (q.Length < 2) return new List<string>();
        var tokens = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var searched = Value.Fields is { Count: > 0 } ? Value.Fields : DefaultSearchFields;
        var hits = new List<string>();
        foreach (var f in searched)
        {
            // Hidden = either the column exists but is toggled off, OR
            // there's no grid column for this field at all (notes).
            var hasCol = AllColumns.Any(c => c.Id == f);
            var visible = hasCol && (!_visibility.TryGetValue(f, out var v) || v);
            if (visible) continue;
            var raw = FieldValue(row, f);
            if (string.IsNullOrEmpty(raw)) continue;
            var lower = raw.ToLowerInvariant();
            if (tokens.Any(t => lower.Contains(t))) hits.Add(f);
        }
        return hits;
    }

    private string BuildHiddenMatchTooltip(InventoryRow row, List<string> fields)
    {
        var q = (Value.Q ?? "").Trim().ToLowerInvariant();
        var tokens = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var parts = new List<string>();
        foreach (var f in fields)
        {
            var raw = FieldValue(row, f) ?? "";
            var lower = raw.ToLowerInvariant();
            var idx = tokens.Select(t => lower.IndexOf(t)).Where(i => i >= 0).DefaultIfEmpty(0).Min();
            var start = Math.Max(0, idx - 15);
            var end = Math.Min(raw.Length, idx + 40);
            var snippet = (start > 0 ? "…" : "") + raw.Substring(start, end - start) + (end < raw.Length ? "…" : "");
            parts.Add($"{f}: \"{snippet}\"");
        }
        return string.Join(" · ", parts);
    }

    private static string? FieldValue(InventoryRow r, string wire) => wire switch
    {
        "productName"     => r.ProductName,
        "serviceNumber"   => r.ServiceNumber,
        "productCategory" => r.ProductCategory,
        "status"          => r.Status,
        "city"            => r.City,
        "state"           => r.State,
        "address"         => r.Address,
        "assignee"        => r.Assignee,
        "notes"           => r.Notes,
        _ => null,
    };

    // ---- Data loading + scrolling (unchanged from prior revision) -----

    protected override async Task OnParametersSetAsync()
    {
        var key = ParamsKey(Value);
        if (key == _appliedKey) return;
        _appliedKey = key;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _rows.Clear();
        _nextCursor = null;
        _hasMore = false;
        _filtered = null;
        _total = null;
        _tookMs = null;
        _error = null;
        _loadingMore = false;
        _localOffset = 0;
        _localFilteredCount = 0;
        StateHasChanged();

        try
        {
            if (UseLocal())
            {
                var res = await Replica.QueryListAsync(ToLocalParams(0), ct);
                if (ct.IsCancellationRequested) return;
                _rows.AddRange(res.Rows);
                _localOffset = _rows.Count;
                _localFilteredCount = res.FilteredCount;
                _filtered = new CountEnvelope(res.FilteredCount, "exact");
                _total = new CountEnvelope(res.TotalCount, "exact");
                _tookMs = res.TookMs;
                _hasMore = _rows.Count < res.FilteredCount;
            }
            else
            {
                var res = await Api.ListAsync(Value with { Cursor = null }, ct);
                if (ct.IsCancellationRequested) return;
                _rows.AddRange(res.Rows);
                _nextCursor = res.NextCursor;
                _hasMore = res.HasMore;
                _filtered = res.FilteredCount;
                _total = res.TotalEstimate;
                _tookMs = res.TookMs;
            }
        }
        catch (OperationCanceledException) { }
        catch (ApiException ex) { _error = ex; }
        catch (Exception ex)
        {
            // Local path can throw when SQLite isn't up yet — surface it
            // as a soft error and let the operator flip back to server.
            _error = new ApiException(new ProblemDetails(null, "Local query failed", 500, ex.Message, null));
        }

        if (_virtualize is not null) await _virtualize.RefreshDataAsync();
        StateHasChanged();
    }

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || !_hasMore) return;
        _loadingMore = true;
        StateHasChanged();
        try
        {
            var ct = _cts?.Token ?? CancellationToken.None;
            if (UseLocal())
            {
                var res = await Replica.QueryListAsync(ToLocalParams(_localOffset), ct);
                _rows.AddRange(res.Rows);
                _localOffset = _rows.Count;
                _localFilteredCount = res.FilteredCount;
                _filtered = new CountEnvelope(res.FilteredCount, "exact");
                _tookMs = res.TookMs;
                _hasMore = _rows.Count < res.FilteredCount;
            }
            else
            {
                if (_nextCursor is null) return;
                var res = await Api.ListAsync(Value with { Cursor = _nextCursor }, ct);
                _rows.AddRange(res.Rows);
                _nextCursor = res.NextCursor;
                _hasMore = res.HasMore;
                _tookMs = res.TookMs;
            }
        }
        catch (OperationCanceledException) { }
        catch (ApiException ex) { _error = ex; }
        finally
        {
            _loadingMore = false;
            StateHasChanged();
        }
    }

    private bool UseLocal() => _mode == "local" && Replica.IsReady;

    private LocalReplica.LocalListParams ToLocalParams(int offset) => new(
        Q: Value.Q,
        Status: Value.Status,
        ProductCategory: Value.ProductCategory,
        State: Value.State,
        Sort: Value.Sort,
        Dir: Value.Dir,
        PageSize: Value.PageSize ?? 100,
        Offset: offset);

    private async Task OnScroll()
    {
        if (!_hasMore || _loadingMore) return;
        var m = await JS.InvokeAsync<ScrollDims>("bruinScroll.metrics", _scrollRef);
        if (m.Total - m.Scrolled < 32 * 10) await LoadMoreAsync();
    }

    private sealed record ScrollDims(double Scrolled, double Total);

    private async Task OnSortClick(Col col)
    {
        if (col.SortKey is null) return;
        var (nextSort, nextDir) = NextSortState(Value.Sort, Value.Dir, col.SortKey);
        await ValueChanged.InvokeAsync(Value with { Sort = nextSort, Dir = nextDir, Cursor = null });
    }

    private static (string? Sort, string? Dir) NextSortState(string? curSort, string? curDir, string col)
    {
        if (curSort != col)     return (col, "desc");
        if (curDir == "desc")   return (col, "asc");
        return (null, null);
    }

    private static string ParamsKey(BruinApiClient.ListParams p) =>
        string.Join('|',
            p.Q ?? "",
            Join(p.Fields), Join(p.Status), Join(p.ProductCategory), Join(p.State),
            p.Sort ?? "", p.Dir ?? "",
            p.PageSize?.ToString() ?? "");

    private static string Join(IReadOnlyCollection<string>? xs) =>
        xs is null ? "" : string.Join(',', xs.OrderBy(x => x));

    private static string Fmt(DateTimeOffset d) => d.LocalDateTime.ToString("MMM d, HH:mm");

    public void Dispose() => _cts?.Cancel();
}
