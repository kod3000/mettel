@* Root router. Single page today (Home), but kept as a Router so a
   future /saved-views/:id or /bulk-jobs/:id route is a one-liner. *@

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p class="p-6 text-sm text-slate-600">Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>
