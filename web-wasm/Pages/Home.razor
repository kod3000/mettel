@page "/"
@inject TenantContext Tenant
@implements IDisposable

@* Home — SavedViewsBar + BulkUploadPanel + Filters + Grid + drawers.
   Layout order mirrors the React SPA. Everything below the topbar is
   inside a @key'd wrapper so a tenant flip tears down state cleanly. *@

<div @key="new { Tenant.Current.Id, Tenant.CurrentRole }" class="flex min-h-0 flex-1 flex-col">
    <SavedViewsBar Params="_params" OnApply="OnParamsChange" />
    <BulkUploadPanel />
    <Filters Value="_params" ValueChanged="OnParamsChange" />
    <div class="flex min-h-0 flex-1 flex-col">
        <InventoryGrid
            Value="_params"
            ValueChanged="OnParamsChange"
            SelectedId="@_selectedId"
            OnRowClick="OnRowClick"
            OnCreateNew="OpenCreate" />
    </div>
</div>

<CreateInventoryModal Open="_createOpen" OnClosed="CloseCreate" OnCreated="OnCreated" />

@if (_selectedId is not null)
{
    <RowDetailDrawer Id="@_selectedId" OnClosed="CloseDrawer" />
}

@if (_apiRefOpen)
{
    <ApiReferencePanel OnClosed="CloseApiRef" />
}

@code {
    [CascadingParameter] public AppActions? Actions { get; set; }

    private BruinApiClient.ListParams _params = new(PageSize: 100);
    private string? _selectedId;
    private bool _createOpen;
    private bool _apiRefOpen;

    protected override void OnInitialized()
    {
        Tenant.OnChanged += OnTenantChanged;
        if (Actions is not null)
        {
            Actions.OpenCreateRequested += OpenCreate;
            Actions.OpenApiRefRequested += OpenApiRef;
        }
    }

    private void OnTenantChanged()
    {
        _params = new(PageSize: 100);
        _selectedId = null;
        _createOpen = false;
        _apiRefOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnParamsChange(BruinApiClient.ListParams next)
    {
        _params = next;
        StateHasChanged();
    }

    private void OnRowClick(InventoryRow row) { _selectedId = row.Id; StateHasChanged(); }
    private void CloseDrawer() { _selectedId = null; StateHasChanged(); }

    private void OpenCreate()  { _createOpen = true;  InvokeAsync(StateHasChanged); }
    private void CloseCreate() { _createOpen = false; StateHasChanged(); }
    private void OnCreated(InventoryRow _) { /* Grid auto-refetches on param change; nothing to do */ }

    private void OpenApiRef()  { _apiRefOpen = true;  InvokeAsync(StateHasChanged); }
    private void CloseApiRef() { _apiRefOpen = false; StateHasChanged(); }

    public void Dispose()
    {
        Tenant.OnChanged -= OnTenantChanged;
        if (Actions is not null)
        {
            Actions.OpenCreateRequested -= OpenCreate;
            Actions.OpenApiRefRequested -= OpenApiRef;
        }
    }
}
