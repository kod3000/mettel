<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bruin.Web.Wasm</RootNamespace>
    <AssemblyName>Bruin.Web.Wasm</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <!-- AOT only when publishing a release build with BlazorWasmAot=true. Local
       `dotnet run` stays interpreted so dev iteration is fast and the
       wasm-tools workload isn't required to be installed. Uses a custom
       property name because .NET's built-in `PublishAOT` is Native AOT and
       errors out on the browser-wasm RID before our condition can fire. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release' and '$(BlazorWasmAot)'=='true'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
  </ItemGroup>

</Project>
