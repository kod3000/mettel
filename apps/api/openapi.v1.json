            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "BulkJobError": {
        "required": [
          "rowNumber",
          "serviceNumber",
          "reason",
          "rawLine"
        ],
        "type": "object",
        "properties": {
          "rowNumber": {
            "type": "integer",
            "format": "int32"
          },
          "serviceNumber": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string"
          },
          "rawLine": {
            "type": "string"
          }
        }
      },
      "BulkJobErrors": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkJobError"
            }
          }
        }
      },
      "BulkJobStatus": {
        "required": [
          "jobId",
          "status",
          "fileName",
          "totalRows",
          "processedRows",
          "succeededRows",
          "failedRows",
          "startedAt",
          "completedAt",
          "errorSampleUrl"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "totalRows": {
            "type": "integer",
            "format": "int32"
          },
          "processedRows": {
            "type": "integer",
            "format": "int32"
          },
          "succeededRows": {
            "type": "integer",
            "format": "int32"
          },
          "failedRows": {
            "type": "integer",
            "format": "int32"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "errorSampleUrl": {
            "type": "string"
          }
        }
      },
      "CountEnvelope": {
        "required": [
          "value",
          "kind"
        ],
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          }
        },
        "nullable": true
      },
      "CreateRequest": {
        "type": "object",
        "properties": {
          "serviceNumber": {
            "type": "string",
            "nullable": true
          },
          "productCategory": {
            "type": "string",
            "nullable": true
          },
          "productName": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "assignee": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
